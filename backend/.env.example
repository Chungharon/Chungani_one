# Email service (Resend — https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Must be a domain verified with Resend. Use onboarding@resend.dev for testing.
RESEND_FROM_EMAIL=you@yourdomain.com
# Set true to skip real email sending during local dev/testing (keep false in prod)
RESEND_DRY_RUN=false

# Where contact-form submissions are delivered
OWNER_EMAIL=you@yourdomain.com

# CORS — the Next.js frontend origin
FRONTEND_ORIGIN=http://localhost:3000

# Database (optional — for later; newsletter / content storage)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
